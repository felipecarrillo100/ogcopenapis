{
  "name": "ogcopenapis",
  "version": "1.0.0",
  "description": "Implements OGC OPEN API Features/Maps/Tiles capabilities and models for LuciadRIA",
  "files": [
    "lib/"
  ],
  "scripts": {
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "transpile": "tsc -p tsconfig.json",
    "copyjs": "copyfiles -u 1 \"src/**/*.js\" ./lib",
    "copycss": "copyfiles -u 1 \"src/**/*.css\" ./lib",
    "copyscss": "copyfiles -u 1 \"src/**/*.scss\" ./lib",
    "copysvg": "copyfiles -u 1 \"src/**/*.svg\" ./lib",
    "copyfonts": "copyfiles -u 1 \"src/fonts/**\" ./lib",
    "build": "npm run transpile && npm run copyjs && npm run copycss && npm run copyscss && npm run copysvg && npm run copyfonts",
    "demo": "vite demo",
    "demo:build": "vite build demo"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^18.11.18",
    "copyfiles": "^2.3.0",
    "jsdom": "^25.0.1",
    "typescript": "^4.6.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.4",
    "vitest-canvas-mock": "^1.2.0"
  },
  "dependencies": {
    "@luciad/ria": ">=2026.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipecarrillo100/ogcopenapis"
  }
}
