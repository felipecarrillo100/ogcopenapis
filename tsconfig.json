{
  "compilerOptions": {
    // LuciadRIA 2026 needs a browser with WebGL or WebGPU, all of them run ES2020
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    // Native ES modules: imports need their .js extension, as LuciadRIA's exports require
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Each file compiles on its own, as per-file transpilers need (Vite, and tsdown later)
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": false,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./src",
    "outDir": "./lib"
  },
  "include": ["./src/**/*"],
  "exclude": ["./node_modules", "./src/**/*.test.ts"]
}
